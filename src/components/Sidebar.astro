---
// Article sidebar: the Fukutsuji guide card, an optional per-article pioneer card,
// and the table of contents.
//
// Two layout rules hold this together, both easy to break by accident:
//
// 1. <aside> is a grid item and keeps the default `align-items: stretch`, so it
//    is as tall as the article beside it. That height is the track the sticky
//    table of contents runs along - a sticky element can never move outside its
//    containing block, so `align-self: start` would shrink the aside to its own
//    content and unstick the TOC almost immediately.
// 2. The TOC is last. A sticky element stays put while later siblings scroll up
//    past it, so anything placed after it would slide underneath.
//
// Sticky also needs no scroll-container ancestor - see the `overflow-x-clip`
// note in BaseLayout.astro.
import { Image } from 'astro:assets';
import guideCover from '../assets/images/shared/fukutsuji-guide-cover.webp';

interface TocItem {
  href: string;
  text: string;
}

interface Props {
  tocItems?: TocItem[];
}

const { tocItems = [] } = Astro.props;

// Page slug, sent to Umami and UTM so we can see which article the click came from.
// Plain link only, no Gumroad script: the site must stay cookie-free.
const source = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'home';
const guideUrl = `https://simpleseniorfitness.gumroad.com/l/fukutsuji-method?utm_source=site&utm_medium=sidebar&utm_campaign=${source}`;
---

<aside class="hidden space-y-8 lg:col-span-4 lg:block">

  <!-- Fukutsuji Guide Card (Gumroad) -->
  <div class="bg-guide-paper border border-stone-200 rounded-xl shadow-lg overflow-hidden">
    <div class="p-6">
      <p class="text-sm font-bold uppercase tracking-widest text-guide-clay mb-4">
        PDF guide for adults 50+
      </p>
      <div class="flex gap-4 mb-4">
        <Image
          src={guideCover}
          alt="Cover of The Fukutsuji Method: A 14-Day Program, a PDF guide"
          widths={[96, 192]}
          sizes="96px"
          class="size-24 shrink-0 rounded-lg object-cover shadow-md"
        />
        <div>
          <h4 class="font-serif text-lg font-semibold text-guide-ink leading-tight">The Fukutsuji Method: A 14-Day Program</h4>
          <p class="text-sm text-stone-600 mt-1">27 pages, instant download</p>
        </div>
      </div>
      <p class="text-base text-stone-700 mb-5 leading-relaxed">
        Five gentle minutes a day with one towel. A step-by-step plan with a printable tracker.
      </p>
      <a
        href={guideUrl}
        rel="noopener"
        data-umami-event="gumroad-click"
        data-umami-event-source={source}
        data-umami-event-placement="sidebar"
        class="flex items-center justify-center gap-2 rounded-full bg-guide-ink px-4 py-3 text-base font-semibold text-white no-underline hover:bg-guide-ink-hover focus:outline-none focus-visible:ring-4 focus-visible:ring-guide-ink/40 focus-visible:ring-offset-2 focus-visible:ring-offset-guide-paper transition-colors"
      >
        Get the guide for $12
      </a>
      <p class="text-sm text-stone-600 text-center mt-2">Secure checkout via Gumroad</p>
    </div>
  </div>

  <!-- Pioneer / Tradition Card (per-article) -->
  <slot name="pioneer" />

  <!-- Table of Contents. Pinned below the sticky header; must stay the last
       child of the aside so the pinned card has nothing to overlap. -->
  {tocItems.length > 0 && (
    <div class="sticky top-24 bg-gray-50 rounded-xl p-6 border border-gray-100">
      <h3 class="font-bold text-lg mb-4 flex items-center gap-2 text-text-main-light">
        <span class="material-symbols-outlined text-accent-dark">list</span>
        In this Article
      </h3>
      <nav id="sidebar-toc" aria-label="Table of contents">
        <ul class="space-y-3 relative border-l border-gray-200 ml-2 pl-4">
          {tocItems.map((item) => (
            <li>
              <a
                class="toc-link block text-sm text-text-muted-light transition-colors hover:text-accent-dark"
                href={item.href}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}

</aside>

<style>
  /* Set by the scroll-spy script below. Plain CSS rather than toggled utility
     classes so the styling sits next to the code that applies it. */
  .toc-link.is-active {
    color: #047857; /* accent-dark */
    font-weight: 500;
  }
</style>

<script>
  // Marks the table-of-contents entry for the section currently being read.
  // Only runs on pages that pass tocItems to <Sidebar />.
  type TocEntry = { link: HTMLAnchorElement; heading: HTMLElement };

  const toc = document.getElementById('sidebar-toc');

  if (toc) {
    // Every TOC link points at an <h2> in the article, so observing the linked
    // headings is the same set of elements, minus any heading without an entry.
    const entries: TocEntry[] = [];
    toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (heading) entries.push({ link, heading });
    });

    if (entries.length > 0) {
      // A heading counts as "current" while it sits in a band just under the
      // sticky header, between 96px and 30% down the viewport.
      const BAND_TOP = 96;
      const visible = new Set<Element>();
      let active: TocEntry | null = null;

      const setActive = (entry: TocEntry) => {
        if (entry === active) return;
        active?.link.classList.remove('is-active');
        active?.link.removeAttribute('aria-current');
        entry.link.classList.add('is-active');
        entry.link.setAttribute('aria-current', 'location');
        active = entry;
      };

      const observer = new IntersectionObserver(
        (records) => {
          for (const record of records) {
            if (record.isIntersecting) visible.add(record.target);
            else visible.delete(record.target);
          }

          const inBand = entries.find((entry) => visible.has(entry.heading));
          if (inBand) {
            setActive(inBand);
            return;
          }

          // Nothing in the band: either we are mid-section, or we scrolled back
          // up out of one. Fall back to the last heading we have scrolled past.
          let passed = entries[0];
          for (const entry of entries) {
            if (entry.heading.getBoundingClientRect().top < BAND_TOP) passed = entry;
          }
          setActive(passed);
        },
        { rootMargin: `-${BAND_TOP}px 0px -70% 0px`, threshold: 0 }
      );

      entries.forEach((entry) => observer.observe(entry.heading));
    }
  }
</script>
