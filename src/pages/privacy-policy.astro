---
import BaseLayout from '../layouts/BaseLayout.astro';

// Keep in sync with the contact page.
const controllerName = 'Peter Andersson';
const contactEmail = 'smartareshopping@gmail.com';

const bullet = 'text-base text-text-muted-light flex items-start gap-2';
const card = 'bg-white p-6 rounded-xl border border-gray-200';
---

<BaseLayout
  title="Privacy Policy & Disclaimer - Simple Senior Fitness"
  description="Read our privacy policy, medical disclaimer, and terms of use. Learn how we protect your data and the limitations of the wellness information we provide."
  keywords="privacy policy, disclaimer, terms of use, medical disclaimer, Simple Senior Fitness"
  canonicalUrl="https://simpleseniorfitness.com/privacy-policy"
  author="Simple Senior Fitness"
>
  <main class="flex-1 w-full max-w-6xl mx-auto pb-12 px-6">
    <section class="pt-10 pb-8 max-w-4xl">
      <span class="inline-block py-1.5 px-3 rounded-full bg-emerald-100 text-accent-dark text-xs font-bold uppercase tracking-wider mb-4 border border-emerald-200">Legal</span>
      <h1 class="font-serif text-[1.2rem] lg:text-[2rem] font-medium leading-tight text-text-main-light mb-6">
        Privacy Policy & Disclaimer
      </h1>
      <p class="text-xl text-text-muted-light">
        Last updated: September 2026
      </p>
    </section>

    <article class="max-w-4xl space-y-8">

      <!-- Quick Navigation -->
      <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
        <h2 class="font-bold text-lg mb-4 flex items-center gap-2 text-text-main-light">
          <span class="material-symbols-outlined text-accent-dark">list</span>
          On This Page
        </h2>
        <nav>
          <ul class="space-y-2">
            <li><a class="text-accent-dark hover:underline" href="#medical-disclaimer">Medical Disclaimer</a></li>
            <li><a class="text-accent-dark hover:underline" href="#privacy-policy">Privacy Policy</a></li>
            <li><a class="text-accent-dark hover:underline" href="#controller">Who Is Responsible</a></li>
            <li><a class="text-accent-dark hover:underline" href="#information-collection">What Data Is Processed</a></li>
            <li><a class="text-accent-dark hover:underline" href="#cookies">Cookies</a></li>
            <li><a class="text-accent-dark hover:underline" href="#third-party">Recipients & Transfers</a></li>
            <li><a class="text-accent-dark hover:underline" href="#your-rights">Your Rights</a></li>
            <li><a class="text-accent-dark hover:underline" href="#terms-of-use">Terms of Use</a></li>
            <li><a class="text-accent-dark hover:underline" href="#contact">Contact Information</a></li>
          </ul>
        </nav>
      </div>

      <!-- Medical Disclaimer -->
      <section id="medical-disclaimer">
        <div class="bg-amber-50 rounded-2xl p-8 border border-amber-200">
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-amber-600 text-3xl flex-shrink-0">warning</span>
            <div>
              <h2 class="font-serif text-[1.5rem] font-medium lg:text-3xl lg:font-medium text-text-main-light mb-4">Medical Disclaimer</h2>
              <p class="text-lg text-text-main-light leading-relaxed mb-4">
                The content on Simple Senior Fitness is for <strong>informational and educational purposes only</strong>. It is not intended to be a substitute for professional medical advice, diagnosis, or treatment.
              </p>
              <p class="text-base text-text-muted-light leading-relaxed mb-4">
                I am not a licensed physician, physical therapist, chiropractor, or healthcare provider. I am a regular person sharing my personal experiences with traditional Japanese wellness practices that have helped me with chronic pain.
              </p>
              <p class="text-base text-text-muted-light leading-relaxed mb-4">
                <strong>Always seek the advice of your physician or other qualified healthcare provider</strong> with any questions you may have regarding a medical condition. Never disregard professional medical advice or delay in seeking it because of something you have read on this website.
              </p>
              <p class="text-base text-text-muted-light leading-relaxed">
                If you think you may have a medical emergency, call your doctor or emergency services immediately. Simple Senior Fitness does not recommend or endorse any specific tests, physicians, products, procedures, opinions, or other information that may be mentioned on this site.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Exercise Disclaimer -->
      <section>
        <div class="bg-emerald-50 rounded-2xl p-8 border border-emerald-200">
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-accent-dark text-3xl flex-shrink-0">fitness_center</span>
            <div>
              <h3 class="font-bold text-xl text-text-main-light mb-3">Exercise & Physical Activity Disclaimer</h3>
              <p class="text-base text-text-muted-light leading-relaxed mb-3">
                The stretching techniques and exercises described on this website should be performed with caution. Before beginning any exercise program, including the Japanese wellness techniques discussed here, you should:
              </p>
              <ul class="space-y-2 ml-4">
                <li class="text-base text-text-muted-light flex items-start gap-2">
                  <span class="text-accent-dark">•</span>
                  Consult with your healthcare provider, especially if you have any pre-existing conditions, injuries, or chronic pain
                </li>
                <li class="text-base text-text-muted-light flex items-start gap-2">
                  <span class="text-accent-dark">•</span>
                  Stop immediately if you experience pain, dizziness, or discomfort
                </li>
                <li class="text-base text-text-muted-light flex items-start gap-2">
                  <span class="text-accent-dark">•</span>
                  Understand that you perform these exercises at your own risk
                </li>
                <li class="text-base text-text-muted-light flex items-start gap-2">
                  <span class="text-accent-dark">•</span>
                  Recognize that individual results may vary
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Privacy Policy -->
      <section id="privacy-policy">
        <h2 class="font-serif text-[1.5rem] font-medium lg:text-3xl lg:font-medium text-text-main-light pt-4 mb-4">
          Privacy Policy
        </h2>
        <p class="text-lg text-text-main-light leading-relaxed mb-4">
          This site is built to collect as little personal data as possible. It sets no cookies, shows no ads, and uses no tracking that follows you across websites. This policy explains exactly what is processed, why, and what rights you have under the EU General Data Protection Regulation (GDPR).
        </p>
      </section>

      <!-- Controller -->
      <section id="controller">
        <h3 class="font-bold text-2xl text-text-main-light mb-4">
          Who Is Responsible for Your Data
        </h3>
        <p class="text-base text-text-muted-light leading-relaxed">
          The data controller for this website is <strong>{controllerName}</strong>, a private individual based in Sweden. You can reach me at <a class="text-accent-dark hover:underline" href={`mailto:${contactEmail}`}>{contactEmail}</a>.
        </p>
      </section>

      <!-- Information Collection -->
      <section id="information-collection">
        <h3 class="font-bold text-2xl text-text-main-light mb-4">
          What Data Is Processed
        </h3>
        <div class="space-y-4">
          <div class={card}>
            <h4 class="font-bold text-lg text-text-main-light mb-2">Server Logs</h4>
            <p class="text-base text-text-muted-light mb-2">
              When you visit the site, the web server automatically records your IP address, the date and time, the page requested, your browser type, and the referring page. This is technically necessary to deliver the site and to protect it against abuse and attacks.
            </p>
            <p class="text-sm text-text-muted-light">
              <strong>Legal basis:</strong> legitimate interest in operating a secure website (Art. 6(1)(f) GDPR). <strong>Retention:</strong> logs are deleted automatically after 14 days.
            </p>
          </div>
          <div class={card}>
              <h4 class="font-bold text-lg text-text-main-light mb-2">Cookie-Free Visitor Statistics</h4>
              <p class="text-base text-text-muted-light mb-2">
                To understand which articles are useful, I count page views with Umami Cloud, a privacy-friendly analytics service. Its data is stored in the EU. It uses no cookies and does not store your IP address or build profiles. It only records aggregated, anonymous figures such as page views, referring sites, country, and device type. If your browser sends a "Do Not Track" signal, nothing is recorded.
              </p>
              <p class="text-sm text-text-muted-light">
                <strong>Legal basis:</strong> legitimate interest in improving the site (Art. 6(1)(f) GDPR).
              </p>
            </div>
          <div class={card}>
            <h4 class="font-bold text-lg text-text-main-light mb-2">Embedded YouTube Videos</h4>
            <p class="text-base text-text-muted-light mb-2">
              Some articles contain videos hosted on YouTube. Until you press play, nothing is loaded from YouTube or Google and no data is sent to them. When you press play, the video loads from YouTube's privacy-enhanced domain (youtube-nocookie.com), and Google receives your IP address and browser information and may store data on your device. See <a class="text-accent-dark hover:underline" href="https://policies.google.com/privacy" rel="noopener" target="_blank">Google's privacy policy</a>.
            </p>
            <p class="text-sm text-text-muted-light">
              <strong>Legal basis:</strong> your consent, given by pressing play (Art. 6(1)(a) GDPR). You can withdraw it at any time by not playing videos and clearing YouTube data in your browser.
            </p>
          </div>
          <div class={card}>
            <h4 class="font-bold text-lg text-text-main-light mb-2">When You Email Me</h4>
            <p class="text-base text-text-muted-light mb-2">
              If you email me, I receive your email address, your name if you include it, and whatever you write. I use it only to reply to you. It is never sold, shared, or used for marketing.
            </p>
            <p class="text-sm text-text-muted-light">
              <strong>Legal basis:</strong> legitimate interest in answering your message (Art. 6(1)(f) GDPR). <strong>Retention:</strong> deleted once the conversation is finished, and no later than 12 months after the last message.
            </p>
          </div>
          <div class={card}>
            <h4 class="font-bold text-lg text-text-main-light mb-2">Fonts and Icons</h4>
            <p class="text-base text-text-muted-light">
              All fonts and icons are served from this website's own server. No requests are made to Google Fonts or other font services.
            </p>
          </div>
        </div>
      </section>

      <!-- Cookies -->
      <section id="cookies">
        <h3 class="font-bold text-2xl text-text-main-light mb-4">
          Cookies
        </h3>
        <p class="text-base text-text-muted-light leading-relaxed">
          This website does not set any cookies and does not use similar tracking technologies. That is why there is no cookie banner. The only exception is YouTube, which may store data on your device after you choose to play a video (see above).
        </p>
      </section>

      <!-- Third-Party Services -->
      <section id="third-party">
        <h3 class="font-bold text-2xl text-text-main-light mb-4">
          Recipients & International Transfers
        </h3>
        <ul class="space-y-2 ml-4 mb-4">
          <li class={bullet}>
            <span class="text-accent-dark">•</span>
            <span><strong>Hetzner Online GmbH (Germany):</strong> hosts the website and its server logs as my data processor. Data stays in the EU.</span>
          </li>
          <li class={bullet}>
            <span class="text-accent-dark">•</span>
            <span><strong>Umami Software, Inc.:</strong> provides the cookie-free visitor statistics as my data processor. It receives only anonymous, aggregated usage data, stored in the EU.</span>
          </li>
          <li class={bullet}>
            <span class="text-accent-dark">•</span>
            <span><strong>Google (YouTube and Gmail):</strong> receives data only if you play a video or email me. Google may transfer data to the United States under the EU–US Data Privacy Framework.</span>
          </li>
        </ul>
        <p class="text-base text-text-muted-light leading-relaxed">
          I never sell your data and do not use it for automated decision-making or profiling.
        </p>
      </section>

      <!-- Your Rights -->
      <section id="your-rights">
        <h3 class="font-bold text-2xl text-text-main-light mb-4">
          Your Rights
        </h3>
        <p class="text-base text-text-muted-light leading-relaxed mb-4">
          Under the GDPR you have the right to:
        </p>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <p class="text-base text-text-muted-light"><strong>Access:</strong> get a copy of the personal data I hold about you</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <p class="text-base text-text-muted-light"><strong>Rectification:</strong> have inaccurate data corrected</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <p class="text-base text-text-muted-light"><strong>Erasure:</strong> have your data deleted</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <p class="text-base text-text-muted-light"><strong>Restriction:</strong> limit how your data is used</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <p class="text-base text-text-muted-light"><strong>Objection:</strong> object to processing based on legitimate interest</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <p class="text-base text-text-muted-light"><strong>Portability:</strong> receive your data in a machine-readable format</p>
          </div>
        </div>
        <p class="text-base text-text-muted-light leading-relaxed mt-4">
          To exercise any of these rights, email me and I will reply within one month. If you believe your data is being handled incorrectly, you can lodge a complaint with the Swedish Authority for Privacy Protection (<a class="text-accent-dark hover:underline" href="https://www.imy.se/en/" rel="noopener" target="_blank">IMY</a>) or the data protection authority in your own country.
        </p>
      </section>

      <!-- Terms of Use -->
      <section id="terms-of-use">
        <h2 class="font-serif text-[1.5rem] font-medium lg:text-3xl lg:font-medium text-text-main-light pt-8 mb-4">
          Terms of Use
        </h2>
        <p class="text-base text-text-muted-light leading-relaxed mb-4">
          By accessing and using Simple Senior Fitness, you agree to the following terms:
        </p>
        <div class="space-y-4">
          <div class="border-l-4 border-accent-dark pl-6 py-2">
            <h4 class="font-bold text-lg text-text-main-light mb-2">Content Usage</h4>
            <p class="text-base text-text-muted-light">All content on this site is for personal, non-commercial use. You may not reproduce, distribute, or modify content without permission.</p>
          </div>
          <div class="border-l-4 border-accent-dark pl-6 py-2">
            <h4 class="font-bold text-lg text-text-main-light mb-2">Accuracy</h4>
            <p class="text-base text-text-muted-light">While I strive to provide accurate information, I make no warranties about the completeness, reliability, or accuracy of the content.</p>
          </div>
          <div class="border-l-4 border-accent-dark pl-6 py-2">
            <h4 class="font-bold text-lg text-text-main-light mb-2">External Links</h4>
            <p class="text-base text-text-muted-light">This site may contain links to external websites. I am not responsible for the content or privacy practices of those sites.</p>
          </div>
          <div class="border-l-4 border-accent-dark pl-6 py-2">
            <h4 class="font-bold text-lg text-text-main-light mb-2">Limitation of Liability</h4>
            <p class="text-base text-text-muted-light">Simple Senior Fitness shall not be held liable for any damages arising from the use of this website or reliance on its content.</p>
          </div>
        </div>
      </section>

      <!-- Affiliate Disclosure -->
      <section>
        <h3 class="font-bold text-2xl text-text-main-light pt-8 mb-4">
          Affiliate Disclosure
        </h3>
        <p class="text-base text-text-muted-light leading-relaxed mb-4">
          This website may contain affiliate links, which means I may receive a commission if you click on a link and make a purchase. This comes at no additional cost to you. I only recommend products or services that I genuinely believe may be helpful.
        </p>
        <p class="text-base text-text-muted-light leading-relaxed">
          Any affiliate relationships will be clearly disclosed on pages containing such links.
        </p>
      </section>

      <!-- Changes to Policy -->
      <section>
        <h3 class="font-bold text-2xl text-text-main-light pt-8 mb-4">
          Changes to This Policy
        </h3>
        <p class="text-base text-text-muted-light leading-relaxed">
          I may update this Privacy Policy and Disclaimer from time to time. Any changes will be posted on this page with an updated revision date. I encourage you to review this page periodically for any changes.
        </p>
      </section>

      <!-- Contact -->
      <section id="contact">
        <h2 class="font-serif text-[1.5rem] font-medium lg:text-3xl lg:font-medium text-text-main-light pt-8 mb-4">
          Contact Information
        </h2>
        <p class="text-base text-text-muted-light leading-relaxed mb-4">
          If you have any questions about this Privacy Policy, the Disclaimer, or your personal data, please contact me:
        </p>
        <div class="bg-white p-6 rounded-xl border border-gray-200">
          <p class="text-base text-text-main-light mb-2">
            <strong>Simple Senior Fitness</strong> – {controllerName}, Sweden
          </p>
          <p class="text-base text-text-muted-light">
            Email: <a class="text-accent-dark hover:underline" href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </p>
        </div>
      </section>

      <!-- Back to Home -->
      <div class="pt-8">
        <a href="/" class="inline-flex items-center gap-2 text-accent-dark hover:underline font-medium">
          <span class="material-symbols-outlined text-sm">arrow_back</span>
          Back to Home
        </a>
      </div>

    </article>
  </main>
</BaseLayout>
