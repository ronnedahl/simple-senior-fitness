---
/**
 * StepStrip: an illustration with several figures side by side (one per step) plus
 * numbered step titles. The image itself has no text; numbers and titles are HTML so
 * they stay sharp on phones and readable for search engines and screen readers.
 *
 * The figures must sit in equal-width columns, one per step, so the number badges
 * line up with them. Images are generated by scripts/generate-images.mjs.
 *
 *   <StepStrip image={img} alt="..." start={5} steps={['Side bend', 'Forward bend']} />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  steps: string[];
  /** Number of the first step, for a strip that continues an earlier one. */
  start?: number;
  caption?: string;
  /** Put the number badges above the figures on phones (for images with space at the top). */
  badgesAboveOnMobile?: boolean;
}

const { image, alt, steps, start = 1, caption, badgesAboveOnMobile = false } = Astro.props;
const cols = `--cols: ${steps.length}`;
---

<figure class="type-exempt my-8">
  <div class="relative">
    <Image
      src={image}
      alt={alt}
      widths={[480, 768, 1152, 1536]}
      sizes="(min-width: 1024px) 760px, 100vw"
      loading="lazy"
      class="w-full h-auto rounded-xl"
    />
    <div
      class:list={[
        'absolute inset-x-0 grid [grid-template-columns:repeat(var(--cols),minmax(0,1fr))] pointer-events-none',
        badgesAboveOnMobile ? 'top-[8%] sm:top-auto sm:bottom-[3%]' : 'bottom-[3%]',
      ]}
      style={cols}
      aria-hidden="true"
    >
      {steps.map((_, i) => (
        <span class="justify-self-center inline-flex items-center justify-center w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-accent-dark text-white text-xs sm:text-sm font-bold shadow">
          {start + i}
        </span>
      ))}
    </div>
  </div>

  <ol
    class="mt-5 grid gap-4 sm:mt-4 sm:gap-3 sm:[grid-template-columns:repeat(var(--cols),minmax(0,1fr))] list-none p-0"
    style={cols}
    start={start}
  >
    {steps.map((step, i) => (
      <li class="flex sm:flex-col items-center gap-3 sm:gap-1 sm:text-center text-base leading-snug text-text-main-light">
        <span class="sm:hidden shrink-0 inline-flex items-center justify-center w-6 h-6 rounded-full bg-accent-dark text-white text-xs font-bold" aria-hidden="true">
          {start + i}
        </span>
        <span>{step}</span>
      </li>
    ))}
  </ol>

  {caption && (
    <figcaption class="mt-3 text-sm italic text-center text-text-muted-light">{caption}</figcaption>
  )}
</figure>
