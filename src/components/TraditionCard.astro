---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  origin: string;
  description: string;
  iconName: string;
  sourceUrl: string;
  sourceLabel: string;
  nameJp?: string;
}

const { name, origin, description, iconName, sourceUrl, sourceLabel, nameJp } = Astro.props;
---

<aside class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
  <span class="block text-[10px] font-bold text-accent-dark uppercase tracking-wider mb-4">Tradition</span>

  <div class="hidden lg:flex items-center justify-center size-20 rounded-full bg-emerald-50 mb-4">
    <Icon name={iconName} class="size-10 text-accent-dark" aria-hidden="true" />
  </div>

  <h3 class="font-serif text-lg font-bold text-text-main-light leading-tight">
    {name}
  </h3>

  {nameJp && (
    <p class="text-sm text-text-muted-light mt-1" lang="ja">{nameJp}</p>
  )}

  <p class="text-sm font-semibold text-accent-dark mt-2 leading-snug">
    {origin}
  </p>

  <p class="text-sm text-text-muted-light leading-relaxed mt-3">
    {description}
  </p>

  <a
    href={sourceUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1 mt-4 text-sm font-bold text-accent-dark hover:underline group"
  >
    <span>{sourceLabel}</span>
    <Icon name="lucide:external-link" class="size-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
    <span class="sr-only">(opens in a new tab)</span>
  </a>

  <a
    href="/pioneers"
    class="block mt-3 text-xs font-medium text-text-muted-light hover:text-accent-dark transition-colors group"
  >
    <span>View all pioneers</span>
    <Icon name="lucide:arrow-right" class="size-3 inline transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
  </a>

  <hr class="my-5 border-gray-100" />

  <p class="text-xs text-text-muted-light italic leading-relaxed">
    This site credits and links to the original developers of each technique. We are not affiliated with them.
  </p>
</aside>
